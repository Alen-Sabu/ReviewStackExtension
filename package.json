{
  "name": "reviewstack",
  "displayName": "ReviewStack",
  "description": "AI-powered repository-aware code review and architecture assistant for VS Code. ",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.119.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewstack",
          "title": "ReviewStack",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "reviewstack": [
        {
          "id": "reviewstack.commitHistory",
          "name": "Commit History"
        }
      ]
    },
    "commands": [
      {
        "command": "reviewstack.reviewLastCommit",
        "title": "ReviewStack: Review Last Commit"
      },
      {
        "command": "reviewstack.openReviewsFolder",
        "title": "ReviewStack: Open Reviews Folder"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.18",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "marked": "^18.0.5"
  }
}
